# NextAuth v5 — secret for JWT signing
AUTH_SECRET=

# Google OAuth — enable "Google Drive API" in Google Cloud Console,
# create OAuth 2.0 Client (Web), set redirect URI to:
#   http://localhost:3000/api/auth/callback/google
# (and your prod URL equivalent). Scopes used:
#   openid email profile https://www.googleapis.com/auth/drive.appdata
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — NextAuth uses AUTH_URL in production behind a proxy
# AUTH_URL=http://localhost:3000

# Optional — NodeNest revision videos Supabase backup.
# Keep the service role key server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — local UploadPilot bridge for YouLearn uploads.
UPLOADPILOT_BASE_URL=http://127.0.0.1:3000
YOULEARN_SPACE_URL=https://app.youlearn.ai/space/c9241bc0721046c8
